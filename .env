# URL base de la API backend (NestJS).
# Debe apuntar al PORT + API_PREFIX del backend, mas el /v1 del versionado de rutas.
# Si cambiaste PORT o API_PREFIX en el .env del backend, actualiza esto para que coincida.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Nombre e identidad visual (fallback en frontend, ej: pantalla de login)
NUXT_PUBLIC_APP_NAME="Inversiones Tamara & Saenz S. En C."
NUXT_PUBLIC_APP_SLOGAN="Resolvemos tu situacion"